{
  "name": "odoo",
  "displayName": "Odoo",
  "description": "Language Server for Odoo projects",
  "version": "1.5.1",
  "publisher": "Odoo",
  "repository": {
    "type": "git",
    "url": "https://github.com/odoo/odoo-vscode"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Snippets",
    "Linters"
  ],
  "icon": "images/odoo_logo.png",
  "activationEvents": [
    "onView:explorer",
    "workspaceContains:**/__manifest__.py",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "csv",
        "aliases": [
          "CSV"
        ],
        "extensions": [
          ".csv"
        ],
        "mimetypes": [
          "text/csv"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.gotoLocation.alternativeDefinitionCommand": ""
    },
    "commands": [
      {
        "command": "odoo.clickStatusBar",
        "title": "Change Configuration",
        "category": "Odoo"
      },
      {
        "command": "odoo.openWelcomeView",
        "title": "Open the Welcome page",
        "category": "Odoo"
      },
      {
        "command": "odoo.openChangelogView",
        "title": "Open the Changelog page",
        "category": "Odoo"
      },
      {
        "command": "odoo.clearState",
        "title": "Wipe the extension's state storage (!!!THIS ACTION IS IRREVERSIBLE!!!)",
        "category": "Odoo"
      },
      {
        "command": "odoo.testCrashMessage",
        "title": "Open the crash notification",
        "category": "Odoo"
      },
      {
        "command": "odoo.disablePythonLanguageServerCommand",
        "title": "Set Python extension LanugageServer to None (Does nothing if python extension is not active)",
        "category": "Odoo"
      },
      {
        "command": "odoo.disableJsLanguageServerCommand",
        "title": "Disable built-in JavaScript/TypeScript language features (validation and suggestions)",
        "category": "Odoo"
      },
      {
        "command": "odoo.restartServer",
        "title": "Restart Language Server",
        "category": "Odoo"
      },
      {
        "command": "odoo.showServerConfig",
        "title": "Show Server Configuration (TOML/JSON)",
        "category": "Odoo"
      }
    ],
    "views": {},
    "menus": {
      "commandPalette": [
        {
          "command": "odoo.testCrashMessage",
          "title": "Open the crash notification",
          "category": "Odoo",
          "when": "odoo.showCrashNotificationCommand"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Odoo",
      "properties": {
        "Odoo.disablePythonLanguageServerPopup": {
          "scope": "window",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Set LanguageServer setting on Python extension to None on workspace level after user input (Does nothing if python extension is not active or already set to `None`)"
        },
        "Odoo.disableJsLanguageServerPopup": {
          "scope": "window",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Suppress the popup asking to disable built-in JavaScript/TypeScript language features when Odoo's server is active"
        },
        "Odoo.serverLogLevel": {
          "scope": "window",
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Filter logs saved to file by the server. Does not impact log displayed in the output window"
        },
        "odooServer.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "Odoo.selectedProfile": {
          "scope": "window",
          "type": "string",
          "description": "Profile active in this workspace"
        },
        "Odoo.serverConfigPath": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Optional path to the server configuration file"
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": [
          "^.*odools.toml$"
        ],
        "url": "https://github.com/odoo/odoo-ls/releases/download/__SCHEMA_VERSION__/config_schema.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "odoo.owl.template",
        "path": "./syntaxes/owl.template.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript"
        },
        "injectTo": [
          "text.xml"
        ]
      },
      {
        "scopeName": "odoo.owl.template.inline",
        "path": "./syntaxes/owl.template.inline.json",
        "embeddedLanguages": {
          "meta.embedded.block.xml": "xml"
        },
        "injectTo": [
          "source.js",
          "text.html"
        ]
      },
      {
        "scopeName": "odoo.owl.markup.inline",
        "path": "./syntaxes/owl.markup.inline.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html"
        },
        "injectTo": [
          "source.js",
          "text.html"
        ]
      }
    ]
  },
  "main": "./client/out/main.js",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./client/extension.ts --bundle --outfile=client/out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./",
    "vscode:uninstall": "node ./client/common/cleanup.mjs"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^18.19.130",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.125.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@vscode-elements/elements": "^1.17.0",
    "@vscode/codicons": "^0.0.33",
    "@vscode/python-extension": "^1.0.6",
    "ejs": "^3.1.10",
    "markdown-it": "^14.3.0",
    "semver": "^7.8.5",
    "vscode-languageclient": "^8.1.0"
  }
}
